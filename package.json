{
  "name": "gestor-incidencias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "tive:simulate": "node --env-file-if-exists=.env scripts/simulate-tive.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.13",
    "chart.js": "^4.5.0",
    "leaflet": "^1.9.4",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0"
  }
}
